{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:it-outsourcing-knowledge-agent:evaluation:gold-v1",
  "title": "WS8 Evaluation Gold Manifest Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "dataset_version",
    "data_provenance",
    "scoring",
    "execution",
    "expected",
    "metric_applicability",
    "authoring"
  ],
  "properties": {
    "schema_version": {
      "const": "gold-v1"
    },
    "case_id": {
      "type": "string",
      "pattern": "^Q\\d{3}$"
    },
    "dataset_version": {
      "const": "v0"
    },
    "data_provenance": {
      "const": "synthetic"
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "SCORABLE",
            "UNSCORABLE_RUNTIME_SCOPE",
            "UNSCORABLE_GOLD"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "benchmark_finding_code": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z0-9_\\-]+$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "SCORABLE"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "UNSCORABLE_RUNTIME_SCOPE",
                  "UNSCORABLE_GOLD"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "business_mode",
        "run_protocol",
        "project_code",
        "user_alias"
      ],
      "properties": {
        "business_mode": {
          "enum": [
            "qa",
            "issue_lookup",
            "issue_create"
          ]
        },
        "run_protocol": {
          "enum": [
            "single_run",
            "authorization_denial",
            "setup_then_run",
            "waiting_confirmation_resume",
            "same_request_replay",
            "response_loss_reconcile",
            "unscorable_runtime_scope"
          ]
        },
        "project_code": {
          "type": "string",
          "minLength": 1
        },
        "user_alias": {
          "type": "string",
          "minLength": 1
        },
        "setup_scenario": {
          "type": [
            "string",
            "null"
          ]
        },
        "fixture_scenario": {
          "type": [
            "string",
            "null"
          ]
        },
        "fault_scenario": {
          "type": [
            "string",
            "null"
          ]
        },
        "request_overrides": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "behavior_class",
        "expected_http_statuses",
        "run_creation_expected",
        "acceptable_run_statuses",
        "identifier_targets",
        "required_evidence_groups",
        "forbidden_doc_codes",
        "current_doc_codes",
        "answer",
        "citations",
        "tool",
        "issue",
        "safety_assertions"
      ],
      "properties": {
        "behavior_class": {
          "type": "string",
          "minLength": 1
        },
        "expected_http_statuses": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "uniqueItems": true
        },
        "run_creation_expected": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "acceptable_run_statuses": {
          "type": "array",
          "items": {
            "enum": [
              "QUEUED",
              "RUNNING",
              "WAITING_CONFIRMATION",
              "SUCCEEDED",
              "REFUSED",
              "CANCELLED",
              "FAILED"
            ]
          },
          "uniqueItems": true
        },
        "identifier_targets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "identifier_type",
              "normalized_value",
              "acceptable_doc_codes"
            ],
            "properties": {
              "identifier_type": {
                "type": "string",
                "minLength": 1
              },
              "normalized_value": {
                "type": "string",
                "minLength": 1
              },
              "acceptable_doc_codes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            }
          }
        },
        "required_evidence_groups": {
          "description": "OR within each inner group; AND across outer groups.",
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "forbidden_doc_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "current_doc_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "answer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "refusal_expected",
            "required_tokens",
            "any_of_token_groups",
            "forbidden_tokens"
          ],
          "properties": {
            "refusal_expected": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "required_tokens": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "any_of_token_groups": {
              "type": "array",
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              }
            },
            "forbidden_tokens": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          }
        },
        "citations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "claim_groups"
          ],
          "properties": {
            "mode": {
              "enum": [
                "required",
                "required_if_answered",
                "forbidden",
                "not_applicable"
              ]
            },
            "claim_groups": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "claim_id",
                  "fact_ids",
                  "acceptable_doc_codes"
                ],
                "properties": {
                  "claim_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "fact_ids": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  },
                  "acceptable_doc_codes": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  }
                }
              }
            }
          }
        },
        "tool": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "live_state_required",
            "required_issue_groups",
            "forbidden_issue_keys",
            "required_status_by_issue",
            "label_as_tool_data"
          ],
          "properties": {
            "live_state_required": {
              "type": "boolean"
            },
            "required_issue_groups": {
              "description": "OR within each inner group; AND across outer groups.",
              "type": "array",
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "forbidden_issue_keys": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "required_status_by_issue": {
              "type": "object",
              "additionalProperties": {
                "enum": [
                  "OPEN",
                  "IN_PROGRESS",
                  "RESOLVED",
                  "CLOSED",
                  "REOPENED"
                ]
              }
            },
            "label_as_tool_data": {
              "type": "boolean"
            }
          }
        },
        "issue": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "draft_expected",
            "confirmation_expected",
            "side_effects_before_confirmation",
            "side_effects_after_confirmation",
            "max_logical_side_effects",
            "expected_creation_outcomes"
          ],
          "properties": {
            "draft_expected": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "confirmation_expected": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "side_effects_before_confirmation": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "side_effects_after_confirmation": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "max_logical_side_effects": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "expected_creation_outcomes": {
              "type": "array",
              "items": {
                "enum": [
                  "CREATED",
                  "ALREADY_CREATED",
                  "PENDING_RECONCILIATION",
                  "RECONCILED"
                ]
              },
              "uniqueItems": true
            }
          }
        },
        "safety_assertions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "uniqueItems": true
        }
      }
    },
    "metric_applicability": {
      "type": "array",
      "items": {
        "enum": [
          "exact_identifier_hit_at_10",
          "evidence_recall_at_10",
          "current_version_hit_rate",
          "citation_id_validity",
          "no_answer_refusal_accuracy",
          "cross_project_evidence",
          "unconfirmed_issue_creation",
          "duplicate_issue_side_effects",
          "critical_regression"
        ]
      },
      "uniqueItems": true
    },
    "authoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_fact_ids",
        "public_reference_ids",
        "notes"
      ],
      "properties": {
        "source_fact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "public_reference_ids": {
          "description": "Authoring realism references only; never acceptable runtime Evidence.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
