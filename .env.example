# Application
APP_ENV=development

# PostgreSQL is integrated in Task 2. Task 1 only validates this value.
DATABASE_URL=postgresql+asyncpg://project_agent:project_agent@localhost:5432/project_agent
LOCAL_STORAGE_ROOT=./data

# RAGFlow is integrated in Task 5. No real network call occurs in Task 1.
RAGFLOW_BASE_URL=http://localhost:9380
RAGFLOW_API_KEY=replace-me
RAGFLOW_EXPECTED_VERSION=v0.26.4
RAGFLOW_IMAGE=infiniflow/ragflow:v0.26.4
RAGFLOW_PARSE_CONCURRENCY=2
RAGFLOW_EMBEDDING_MODEL=
RAGFLOW_CHUNK_METHOD=naive
RAGFLOW_REQUEST_TIMEOUT_SECONDS=30
RAGFLOW_MAX_ATTEMPTS=3

# Structured LLM provider configuration. WS4 live calls run only in explicit live gates.
LLM_BASE_URL=https://api.example.invalid/v1
LLM_API_KEY=replace-me
LLM_MODEL_ALIAS=replace-me
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=3
LLM_REQUEST_CAPACITY=10
LLM_TOKEN_CAPACITY=100000

# V1 feature switches / local runtime settings
SANDBOX_TRACKER_ENABLED=true
PROMPT_CACHE_TTL_SECONDS=30
RETENTION_SWEEP_ENABLED=true

# Task 8 worker/reliability
RETENTION_SWEEP_DRY_RUN=true
WORKER_CONCURRENCY=4
WORKER_CLAIM_LIMIT=4
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_SECONDS=15
WORKER_POLL_SECONDS=1
WORKER_RETRY_BASE_SECONDS=5
WORKER_RETRY_MAX_SECONDS=300
WORKER_INGEST_DOCUMENT_ENABLED=false
WORKER_DELETE_DOCUMENT_ENABLED=false
LLM_RATE_WINDOW_SECONDS=60
LLM_RATE_LIMIT_WAIT_TIMEOUT_SECONDS=30

# Task 9 authentication. JWT supplies only trusted user identity; project roles are DB-derived.
JWT_HS256_SECRET=replace-me-with-a-random-secret-at-least-32-bytes
JWT_ISSUER=project-agent
JWT_AUDIENCE=project-agent-api
JWT_LEEWAY_SECONDS=30

# Task 13 write confirmation window
TOOL_CONFIRMATION_TTL_SECONDS=900

# Task 10 LangGraph checkpoint deserialization hardening
LANGGRAPH_STRICT_MSGPACK=true
